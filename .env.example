# Model config lives in the app: Settings -> Providers (OpenAI-compatible endpoints).

# Per-request limits for configured models.
# LLM_CONTEXT_WINDOW=64000
# LLM_MAX_TOKENS=4096

# Server
PORT=8075

# Storage
DATABASE_PATH=./data/bots.db

# Encryption key for secrets, provider API keys and VAPID material (32 random bytes as hex).
# Generate it outside the data volume with: openssl rand -hex 32
# SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Context management (approximate tokens, chars/4).
# Without COMPACTION_TOKEN_THRESHOLD compaction triggers automatically at
# COMPACTION_RATIO of LLM_CONTEXT_WINDOW.
# COMPACTION_TOKEN_THRESHOLD=24000
# COMPACTION_RATIO=0.75
COMPACTION_KEEP_RECENT=16
