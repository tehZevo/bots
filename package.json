{
  "name": "bots",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted scheduled AI bots: create bots, run them on a schedule against any OpenAI-compatible provider.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @bots/server dev\" \"pnpm --filter @bots/web dev\"",
    "build": "pnpm --filter @bots/server build && pnpm --filter @bots/web build",
    "start": "node --env-file-if-exists=.env packages/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  }
}
